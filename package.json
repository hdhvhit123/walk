{
  "name": "walk-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --platform android --clean",
    "test:app": "jest",
    "test:native": "bash scripts/check-native.sh",
    "test:all": "npm run typecheck && npm test && npm run test:app"
  },
  "dependencies": {
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-location": "~19.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "jest-expo": "~54.0.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^2.1.9"
  },
  "private": true
}
